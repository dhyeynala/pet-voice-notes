# PetPulse configuration. Every value below is optional: with no .env at all the app runs
# in demo mode (deterministic fake AI, local JSON store, no network calls, no secrets).
# Copy to .env only if you want to change something:  cp .env.example .env
# Never commit .env.
#
# Comments go on their own line, never after a value: Docker Compose (env_file) reads
# `KEY=   # note` as the value "# note". tests/unit/test_config.py enforces this.

# --- Mode and storage ------------------------------------------------------------------
# enables demo-only endpoints (demo login and reset)
DEMO_MODE=true
# json (persists to DATA_DIR/db.json) | memory (lost on restart)
STORE=json
# JSON store + local blobs (PDF uploads) live here
DATA_DIR=data
# load the demo seed (Alice, Bob, their pets) into an empty store at startup
SEED_ON_START=true
# DEBUG | INFO | WARNING | ERROR for the petpulse.* loggers
LOG_LEVEL=INFO

# --- AI providers ----------------------------------------------------------------------
# auto = use the real provider when its key is set, otherwise the deterministic fake.
# An explicit value always wins; an explicit live provider without its key fails at startup.
# auto | fake | openai
LLM_PROVIDER=auto
# auto | fake | openai | google  (auto never picks google)
STT_PROVIDER=auto
# leave empty for demo mode; setting it switches auto -> live (billed)
OPENAI_API_KEY=
# pinned dated snapshot; undated aliases are rejected at startup
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# per provider call; one SDK retry, then one schema-repair retry at most
LLM_TIMEOUT_SECONDS=30
# fake provider drills: normal | invalid_once | truncate | fail
FAKE_LLM_MODE=normal
# GOOGLE_APPLICATION_CREDENTIALS: service-account JSON path, only for STT_PROVIDER=google
# (Google STT also needs the live extras: INSTALL_LIVE=true docker compose build)
GOOGLE_APPLICATION_CREDENTIALS=
# hard cap on provider calls in the live smoke test (scripts/smoke_live.py)
LIVE_CALL_CAP=6

# --- Speech-to-text and voice notes ----------------------------------------------------
# pinned snapshot; whisper-1 also works
STT_OPENAI_MODEL=gpt-4o-mini-transcribe-2025-12-15
# Google STT v1 recognition model (only for STT_PROVIDER=google)
STT_GOOGLE_MODEL=default
# BCP-47; OpenAI gets the language part ("en")
STT_LANGUAGE=en-US
# per-request timeout for the live STT providers
STT_TIMEOUT_SECONDS=30
# upload size cap for POST /api/pets/{id}/voice-notes (5 MiB)
VOICE_MAX_BYTES=5242880
# max clip length, checked from the container header where possible
VOICE_MAX_SECONDS=60

# --- Web / auth --------------------------------------------------------------------------
# comma-separated CORS allow-list ('*' is rejected)
ALLOWED_ORIGINS=http://localhost:8000
# demo-login signing secret; random per process when empty (restart = log in again)
AUTH_SECRET=
# lifetime of a demo login token
AUTH_TOKEN_TTL_MINUTES=720

# --- Optional Firebase mode (docs/firebase.md; needs requirements/live.txt) ----------------
# auto = Firebase only when it is configured (credentials below), else the local store / demo login.
# An explicit firestore/firebase without what it needs fails at startup.
# auto | json (the local STORE above) | firestore
STORE_BACKEND=auto
# auto | demo | firebase (firebase disables demo login)
AUTH_PROVIDER=auto
# e.g. my-petpulse
FIREBASE_PROJECT_ID=
# inline service-account JSON (or GOOGLE_APPLICATION_CREDENTIALS + FIREBASE_PROJECT_ID)
FIREBASE_CREDENTIALS_JSON=
# e.g. my-petpulse.firebasestorage.app; empty = record PDFs stay in DATA_DIR
FIREBASE_STORAGE_BUCKET=
# browser SDK apiKey (public config, needed for Firebase sign-in)
FIREBASE_WEB_API_KEY=
# default <project>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=

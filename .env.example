# PetPulse configuration. Every value below is optional: with no .env at all the app runs
# in demo mode (deterministic fake AI, local JSON store, no network calls, no secrets).
# Copy to .env only if you want to change something:  cp .env.example .env
# Never commit .env.

# --- Mode and storage ------------------------------------------------------------------
DEMO_MODE=true                 # enables demo-only endpoints (demo login/reset, later tracks)
STORE=json                     # json (persists to DATA_DIR/db.json) | memory (lost on restart)
DATA_DIR=data                  # JSON store + local blobs (PDF uploads) live here
SEED_ON_START=true             # load the demo seed (Alice, Bob, their pets) into an empty store at startup
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR for the petpulse.* loggers

# --- AI providers ----------------------------------------------------------------------
# auto = use the real provider when its key is set, otherwise the deterministic fake.
# An explicit value always wins; an explicit live provider without its key fails at startup.
LLM_PROVIDER=auto              # auto | fake | openai
STT_PROVIDER=auto              # auto | fake | openai | google  (auto never picks google)
OPENAI_API_KEY=                # leave empty for demo mode; setting it switches auto -> live (billed)
OPENAI_MODEL=gpt-5.4-mini-2026-03-17   # pinned dated snapshot; undated aliases are rejected at startup
LLM_TIMEOUT_SECONDS=30         # per provider call; one SDK retry, then one schema-repair retry at most
FAKE_LLM_MODE=normal           # fake provider drills: normal | invalid_once | truncate | fail
# GOOGLE_APPLICATION_CREDENTIALS: service-account JSON path, only for STT_PROVIDER=google
# (Google STT also needs the live extras: INSTALL_LIVE=true docker compose build)
GOOGLE_APPLICATION_CREDENTIALS=
LIVE_CALL_CAP=6                # hard cap on provider calls in the live smoke test (scripts/smoke_live.py)

# --- Speech-to-text and voice notes ----------------------------------------------------
STT_OPENAI_MODEL=gpt-4o-mini-transcribe-2025-12-15   # pinned snapshot; whisper-1 also works
STT_GOOGLE_MODEL=default       # Google STT v1 recognition model (only for STT_PROVIDER=google)
STT_LANGUAGE=en-US             # BCP-47; OpenAI gets the language part ("en")
STT_TIMEOUT_SECONDS=30         # per-request timeout for the live STT providers
VOICE_MAX_BYTES=5242880        # upload size cap for POST /api/pets/{id}/voice-notes (5 MiB)
VOICE_MAX_SECONDS=60           # max clip length, checked from the container header where possible

# --- Web / auth --------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8000   # comma-separated CORS allow-list ('*' is rejected)
AUTH_SECRET=                   # demo-login signing secret; random per process when empty (restart = log in again)
AUTH_TOKEN_TTL_MINUTES=720     # lifetime of a demo login token

# --- Optional Firebase mode (docs/firebase.md; needs requirements-live.txt) -----------------
# auto = Firebase only when it is configured (credentials below), else the local store / demo login.
# An explicit firestore/firebase without what it needs fails at startup.
STORE_BACKEND=auto             # auto | json (the local STORE above) | firestore
AUTH_PROVIDER=auto             # auto | demo | firebase (firebase disables demo login)
FIREBASE_PROJECT_ID=           # e.g. my-petpulse
FIREBASE_CREDENTIALS_JSON=     # inline service-account JSON (or GOOGLE_APPLICATION_CREDENTIALS + FIREBASE_PROJECT_ID)
FIREBASE_STORAGE_BUCKET=       # e.g. my-petpulse.firebasestorage.app; empty = record PDFs stay in DATA_DIR
FIREBASE_WEB_API_KEY=          # browser SDK apiKey (public config, needed for Firebase sign-in)
FIREBASE_AUTH_DOMAIN=          # default <project>.firebaseapp.com

# --- Optional breed lookups (legacy; network calls only when a key is set) ---------------
DOG_API_KEY=
CAT_API_KEY=
